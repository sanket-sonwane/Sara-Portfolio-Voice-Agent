# Copy to .env and fill in. Never commit .env.
# Every value here is backend-only; nothing may reach the browser bundle.
#
# The default profile is `bom-india` (ADR 0002): Sarvam ASR and LLM in-region,
# Smallest Lightning TTS (ADR 0004), gateway in Singapore. `local` needs no keys
# at all.

# --- profile ---------------------------------------------------------------
# bom-india (default) | iad-global | local
SARANG_PROFILE=bom-india
# dev | staging | production
SARANG_ENV=dev
# Override the profile's TTS arm: smallest | cartesia | sarvam | synthetic
# TTS_PROVIDER=smallest

# --- Sarvam (ASR + LLM, India) --------------------------------------------
SARVAM_API_KEY=
# SARVAM_LLM_MODEL=sarvam-30b
# SARVAM_ASR_MODEL=saarika:v2.5
# SARVAM_TTS_MODEL=bulbul:v4-flash
# SARVAM_VOICE=anushka
# SARVAM_BASE_URL=https://api.sarvam.ai

# --- Gemini (LLM, asia-south1) --------------------------------------------
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash-lite
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# --- Smallest AI (TTS, product path) --------------------------------------
SMALLEST_API_KEY=
# SMALLEST_MODEL=lightning_v3.1_pro
# SMALLEST_VOICE=rhea
# "hi" is Indian-accented English with Hindi code-switching; "en" is UK/US.
# SMALLEST_LANGUAGE=hi
# SMALLEST_MAX_CONCURRENCY=4

# --- Comparison arms (not the product path) -------------------------------
GROQ_API_KEY=
CARTESIA_API_KEY=
# "Ella - Caring Scout": feminine, en-AU. Swap for any Cartesia voice id.
CARTESIA_VOICE_ID=2a12b36c-7f9b-4c3a-9f7a-72731b15323a
# CARTESIA_MODEL=sonic-latest
NVIDIA_API_KEY=

# --- Auth -----------------------------------------------------------------
# Required in production; rotate to invalidate every live session.
SESSION_SECRET=
# ALLOWED_ORIGINS=https://sanket--sonwane.vercel.app,http://localhost:5173

# --- Media ----------------------------------------------------------------
# urls|user:secret;urls|user:secret
ICE_SERVERS=
ICE_FORCE_RELAY=false
ENABLE_WEBRTC=true

# --- Retrieval ------------------------------------------------------------
# Enables pgvector/tsvector tier-2 retrieval. BM25 is used when unset.
DATABASE_URL=

# --- Behaviour ------------------------------------------------------------
# ENDPOINT_SILENCE_MS=700
# SPECULATIVE_MS=0
# FILLER_ENABLED=true
# SARANG_CACHE_DIR=

# --- Deployment -----------------------------------------------------------
FLY_API_TOKEN=
TURN_SHARED_SECRET=
